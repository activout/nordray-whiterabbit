<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewData["Title"] — White Rabbit</title>
    @* Colours and type follow the Nordray landing page (nordray-access-landing, site/style.css). *@
    <style>
        :root {
            --bg: #f6f8f9; --surface: #ffffff; --ink: #0a0d2e; --muted: #4d5d6c; --line: #d9e0e5;
            --accent: #0b6e4f; --accent-ink: #ffffff; --hero-bg: #040720; --hero-ink: #f6f8f9;
            --ray: #5ff0a0; --error: #b3261e;
        }
        @@media (prefers-color-scheme: dark) {
            :root {
                --bg: #070a26; --surface: #0e1238; --ink: #f1f3fb; --muted: #aab1d1; --line: #232a5c;
                --accent: #5ff0a0; --accent-ink: #04210f; --error: #ffb4ab;
            }
        }
        * { box-sizing: border-box; }
        body {
            margin: 0; min-height: 100vh; display: flex; flex-direction: column;
            background: var(--bg); color: var(--ink);
            font: 1.0625rem/1.6 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        }
        header { background: var(--hero-bg); color: var(--hero-ink); border-bottom: 1px solid var(--line); }
        header .wrap { padding-block: 20px; display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 1.125rem; }
        header .wrap::before { content: ""; width: 10px; height: 10px; border-radius: 50%; background: var(--ray); box-shadow: 0 0 12px var(--ray); }
        header a { color: inherit; text-decoration: none; }
        .wrap { max-width: 480px; margin: 0 auto; padding: 0 20px; width: 100%; }
        main { flex: 1; padding: 56px 0; }
        .card { padding: 28px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); }
        h1 { font-size: clamp(1.5rem, 4vw, 2rem); line-height: 1.2; letter-spacing: -0.01em; margin: 0 0 1rem; text-wrap: balance; }
        p { margin: 0.5rem 0 0; }
        a { color: var(--accent); }
        :focus-visible { outline: 3px solid var(--ray); outline-offset: 2px; }
        form { display: grid; gap: 16px; margin-top: 1.5rem; }
        label { display: block; font-weight: 600; font-size: 0.9375rem; }
        input[type=email], input[type=text] {
            display: block; width: 100%; margin-top: 6px; padding: 11px 12px; border: 1px solid var(--line); border-radius: 8px;
            background: var(--bg); color: var(--ink); font: inherit;
        }
        button {
            justify-self: start; padding: 12px 22px; border: 0; border-radius: 8px;
            background: var(--accent); color: var(--accent-ink); font: inherit; font-weight: 600; cursor: pointer;
        }
        button:hover { filter: brightness(1.1); }
        .error { color: var(--error); margin: 0; font-size: 0.9375rem; }
        .hint { color: var(--muted); font-size: 0.9375rem; margin: 0; }
        h1 + .hint, p + .hint { margin-top: 0.5rem; }
        code { font: 0.9em ui-monospace, SFMono-Regular, Menlo, monospace; padding: 1px 5px; border: 1px solid var(--line); border-radius: 5px; }
        ul { padding-left: 1.25rem; }
        footer { padding: 24px 0 40px; color: var(--muted); font-size: 0.875rem; }
    </style>
</head>
<body>
    <header><div class="wrap"><span><a href="https://nordray.eu/">Nordray</a> White Rabbit</span></div></header>
    <main>
        <div class="wrap">
            <div class="card">
                @RenderBody()
            </div>
        </div>
    </main>
    <footer><div class="wrap">Keeps your bunny.net API key out of CI/CD. <a href="https://nordray.eu/white-rabbit/">About White Rabbit</a></div></footer>
</body>
</html>
